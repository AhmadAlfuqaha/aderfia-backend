# ---------------------------------------------------------------------------
# Aderfia API — production environment
#
# Copy to wherever your host keeps secrets. Do NOT commit the filled-in copy.
# ASP.NET Core maps `__` to the `:` in a config key, so `Cors__AllowedOrigins__0`
# sets `Cors:AllowedOrigins[0]`.
# ---------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production

# ---- Admin API key --------------------------------------------------------
# The ONLY credential for /api/admin/*. Generate a fresh one — never reuse the
# development key in appsettings.Development.json. If this is unset, the admin
# API refuses every request (fails closed) and the admin UI cannot sign in.
#
#   openssl rand -base64 32
#
ADERFIA_ADMIN_KEY=

# ---- Hosting --------------------------------------------------------------
# Kestrel reads ASPNETCORE_URLS. It does NOT read a bare PORT, so this must be
# set explicitly, and on 0.0.0.0 — bound to localhost, nothing outside the
# container can reach it. The Dockerfile sets this same default.
ASPNETCORE_URLS=http://0.0.0.0:10000

# ---- Database -------------------------------------------------------------
# REQUIRED. Without it the provider falls back to SQLite: the app still boots,
# /health still returns 200 so the platform calls the deploy healthy, and then
# every request 500s against an empty throwaway database inside the container.
# Verified behaviour, not a theory.
Database__Provider=SqlServer

# Azure SQL. Encrypt=True is required; Azure rejects unencrypted connections.
# Paste the real value into the host's secret store ONLY — never into a file.
ConnectionStrings__Default=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30

# ---- Media ----------------------------------------------------------------
# ABSOLUTE URL, not a path. The storefront runs on its own origin, so a
# root-relative "/media" resolves against the storefront and 404s every image.
# Point this at the CDN if one fronts the images.
Media__BaseUrl=https://api.aderfia-jo.com/media

# ---- CORS -----------------------------------------------------------------
# Every origin the storefront is served from. Exact scheme + host, no trailing
# slash. Both entries are needed if Netlify serves the apex and www.
#
# Add your Netlify preview domain (aderfia.netlify.app) as __2 while testing,
# and remove it once the custom domain is live.
Cors__AllowedOrigins__0=https://aderfia-jo.com
Cors__AllowedOrigins__1=https://www.aderfia-jo.com

# ---- Reverse proxy --------------------------------------------------------
# Set to true ONLY when this app is reachable exclusively through a proxy you
# control (nginx, Caddy, Cloudflare, a PaaS load balancer). It makes the app
# trust X-Forwarded-For / X-Forwarded-Proto, which is required for HTTPS
# redirection and the cart cookie's Secure flag to work behind TLS termination
# — and which lets a direct caller spoof its IP past the admin rate limiter if
# the app is also reachable directly.
ForwardedHeaders__Enabled=true
