{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=aderfia.db"
  },

  "Media": {
    "_comment": "Prefix applied to every stored image key. Point this at a CDN in production; no data migration is needed.",
    "BaseUrl": "/media"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
