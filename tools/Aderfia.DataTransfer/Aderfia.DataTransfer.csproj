<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-time SQLite -> SQL Server catalogue transfer.
       Not referenced by the application; it exists to be run by hand. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aderfia.DataTransfer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aderfia.Persistence\Aderfia.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

</Project>
